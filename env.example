# Configure only in the server's secret/environment settings.
PUBLIC_ORIGIN=https://companion.example.com
# PostgreSQL + psycopg; provide a CA via sslrootcert if the provider requires one.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
MODEL_ENDPOINT=https://YOUR_MODEL_PROVIDER/v1
MODEL_API_KEY=REPLACE_WITH_SERVER_ONLY_KEY
EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL
GENERATION_MODEL=REPLACE_WITH_GENERATION_MODEL
